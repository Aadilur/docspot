# Backend example env
# Local dev only. On Railway, DO NOT set PORT manually.
PORT=3001

# =========================
# Database (Postgres)
# =========================
# Provide DATABASE_URL (e.g. Railway provides this automatically)
DATABASE_URL=

# =========================
# Cache (Redis)
# =========================
# Optional, but recommended if you plan to use rate limits, caching, job queues, etc.
# Example: redis://default:<password>@<host>:<port>
REDIS_URL=
# Optional: prefix applied to all app keys to avoid collisions across environments
REDIS_KEY_PREFIX=docspot:

# =========================
# Object storage (S3-compatible)
# =========================
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Most S3-compatible providers work best with path-style URLs on custom endpoints
S3_FORCE_PATH_STYLE=true

# =========================
# Auth (Firebase)
# =========================
# Firebase Admin SDK service account JSON (paste full JSON as a single line).
# Required for verifying Firebase ID tokens (Authorization: Bearer <token>).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin authorization
# Preferred: set a Firebase custom claim `admin: true` on your user.
# Fallback/bootstrap: comma-separated Firebase user UIDs that can call admin-only endpoints.
ADMIN_UIDS=

# Admin UI login page (optional): Firebase Web App config JSON (single line string)
# Enables /admin/login email+password flow.
FIREBASE_WEB_CONFIG_JSON=

# Admin session cookie settings (optional)
ADMIN_SESSION_DAYS=7
ADMIN_SESSION_COOKIE=docspot_admin_session

# CORS (optional)
# For local dev, you can allow your Vite origin.
CORS_ORIGIN=http://localhost:5173

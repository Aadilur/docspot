# Firebase (Frontend)
# Create a Firebase project -> Web app -> copy config values here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional (Analytics)
VITE_FIREBASE_MEASUREMENT_ID=

# Optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Backend API base URL
VITE_API_BASE_URL=http://localhost:3001

# Google AdSense (Web)
# - Client: starts with `ca-pub-...`
# - Slots: numeric `data-ad-slot` ids from your AdSense ad units
#
# This codebase currently renders AdSense using `data-ad-format="auto"` (responsive display).
# So you should use **Display / Responsive** ad unit ids for the slots below.
#
# You can reuse the same Display slot id for all placements to start.
# (Creating separate ad units per placement is better for reporting/optimization.)
#
# Note: Multiplex/Matched-content and true Native (in-feed/in-article) units often require
# different `data-ad-format` and sometimes a `data-ad-layout-key`. They are not required.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_FOOTER=
VITE_ADSENSE_SLOT_SHARE=
VITE_ADSENSE_SLOT_FEED=
VITE_ADSENSE_SLOT_GATE=

# Dev/testing
# When true, ad slots are marked as test ads.
# Use this while developing to reduce invalid-traffic risk.
VITE_ADSENSE_TEST_MODE=false

# Google Ad Manager (Rewarded Ads)
# Requires a GAM network + a rewarded ad unit path like: /1234567/docspot_rewarded
VITE_GAM_REWARDED_AD_UNIT_PATH=


